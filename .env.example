# Zeitzone für Container-Logs (MESZ/MEZ)
TZ=Europe/Berlin

# ==========================================
# 1. Binance API KEYS
# ==========================================
EXCHANGE_KEY=
EXCHANGE_SECRET=

# ==========================================
# 2. FREQUI (WEB-OBERFLÄCHE)
# ==========================================
API_USERNAME=admin
API_PASSWORD=change_me

JWT_SECRET_KEY=change_me_long_random_string
WS_TOKEN=change_me_long_random_string

# ==========================================
# 3. TELEGRAM BOT (OPTIONAL)
# ==========================================
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# 4. GEMINI / LLM (Optimizer-Advisor)
# ==========================================
GEMINI_API_KEY=
GEMINI_ADVISOR=true
GEMINI_ON_STREAK=true
LLM_MODEL=gemini-2.0-flash
# Optional OpenAI-kompatibel statt Gemini:
# LLM_API_URL=
# LLM_API_KEY=

# ==========================================
# 5. OPTIMIZER (Smart / Streak)
# ==========================================
# Poll alle 5 Min; bei Streak/Distress alle 2 Min
OPTIMIZER_POLL_SECONDS=300
OPTIMIZER_POLL_FAST_SECONDS=120
OPTIMIZER_TRADE_THRESHOLD=12
OPTIMIZER_MIN_HOURS=4
OPTIMIZER_SETTLED_HOURS=12
OPTIMIZER_DISTRESS_MIN_HOURS=1.0
OPTIMIZER_DISTRESS_TRADES=6
OPTIMIZER_DISTRESS_WINRATE=0.40
OPTIMIZER_DISTRESS_AVG_PROFIT=-0.003
# Nach N Verlusten in Folge → Gemini-Fast + Heuristik (ohne Hyperopt)
OPTIMIZER_LOSE_STREAK=3
OPTIMIZER_STREAK_MIN_HOURS=0.25
OPTIMIZER_STREAK_SKIP_HYPEROPT=true
OPTIMIZER_RUN_ON_START=false

# ==========================================
# 6. TRADE JOURNAL (Telegram-Batch + Logdatei)
# ==========================================
# Alle N geschlossenen Trades → Telegram-Zusammenfassung
JOURNAL_ENABLED=true
JOURNAL_TELEGRAM_BATCH=5
JOURNAL_LOOKBACK=200
# Markdown (zum Teilen) + JSONL (maschinenlesbar)
JOURNAL_FILE=/freqtrade/user_data/logs/trade_journal.md
JOURNAL_JSONL=/freqtrade/user_data/logs/trade_journal.jsonl
